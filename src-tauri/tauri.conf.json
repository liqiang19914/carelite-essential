{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小凯同学HMS",
  "version": "0.2.0",
  "identifier": "com.carelite.essential",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小凯同学HMS",
        "width": 1280,
        "height": 832,
        "minWidth": 375,
        "minHeight": 667,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
